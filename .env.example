# API gateway
NEXT_PUBLIC_API_URL=http://localhost:8080
# Google Identity Services Web client ID; authorize the storefront origin in Google Cloud.
# Add the actual storefront origin (for example, http://localhost:6001 and
# http://localhost:3000) as an authorized JavaScript origin in Google Cloud.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Demo checkout UI hint only. The order-service environment lock is authoritative.
NEXT_PUBLIC_PAYMENT_DEMO_LOCK=true

# Public Stripe publishable key only; never use NEXT_PUBLIC_* for a secret key.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Public display configuration. Merchant and bank details are returned by the
# authenticated payment API; gateway credentials must remain in E-Commerce-BG.
NEXT_PUBLIC_USD_TO_BDT_RATE=110
